# Arolink SIH Healthcare Backend Configuration
PROJECT_NAME="Arolink Healthcare API"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Database configuration
# PostgreSQL format: postgresql+psycopg://<username>:<password>@<host>:<port>/<database_name>
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/arolink_db

# Optional: Set to True to automatically create tables on startup if not using Alembic
AUTO_CREATE_TABLES=True

# Authentication (for future auth module)
SECRET_KEY="temporary-secret-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ABHA / ABDM Sandbox configuration (for future ABHA module)
ABDM_CLIENT_ID=""
ABDM_CLIENT_SECRET=""
ABDM_BASE_URL="https://dev.abdm.gov.in"
